package br.com.jumpman.platforms;

import java.awt.Color;
import java.awt.Graphics;
import java.awt.Rectangle;
import java.util.ArrayList;
import java.util.List;

import br.com.jumpman.data.enums.StatusMovimento;
import br.com.jumpman.data.enums.TipoMovimento;
import br.com.jumpman.platforms.movement.DropablePlatformStrategy;
import br.com.jumpman.platforms.movement.MovementStrategy;
import br.com.jumpman.platforms.movement.MovingPlatformStrategy;
import br.com.jumpman.platforms.movement.StaticPlatformStrategy;

/**
 * Implementação avançada de plataforma com movimentos dinâmicos
 * Utiliza o padrão Strategy para gerenciar diferentes tipos de movimento
 */
public class PlataformaDinamica extends PlataformaSimples {
    
    // Classe interna para representar pontos de movimento
    public static class Ponto {
        public int x, y;
        public int delaySegundos; // Tempo para aguardar neste ponto antes de ir ao próximo
        
        public Ponto(int x, int y, int delaySegundos) {
            this.x = x;
            this.y = y;
            this.delaySegundos = delaySegundos;
        }
        
        public Ponto(int x, int y) {
            this(x, y, 0); // Sem delay por padrão
        }
    }
    
    // Propriedades da plataforma dinâmica
    private TipoMovimento tipo;
    private MovementStrategy movementStrategy; // Estratégia de movimento
    private float velocidade; // pixels por frame
    
    // Campos para rastrear o último movimento da plataforma
    private int deltaX;
    private int deltaY;
    private int xAnterior;
    private int yAnterior;
    
    /**
     * Construtor para plataforma MOVABLE (que se move entre pontos)
     */
    public PlataformaDinamica(int x, int y, int w, int h, 
                             List<Ponto> pontos, boolean looping, float velocidade) {
        super(x, y, w, h);
        this.tipo = TipoMovimento.MOVABLE;
        this.velocidade = velocidade;
        this.deltaX = 0;
        this.deltaY = 0;
        this.xAnterior = x;
        this.yAnterior = y;
        
        // Criar a estratégia de movimento adequada
        this.movementStrategy = new MovingPlatformStrategy(this, pontos, looping, velocidade);
    }
    
    /**
     * Construtor para plataforma DROPABLE (que cai depois de um tempo)
     */
    public PlataformaDinamica(int x, int y, int w, int h, 
                             int tempoParaCairSegundos, boolean visibleAfterFall) {
        super(x, y, w, h);
        this.tipo = TipoMovimento.DROPABLE;
        this.velocidade = 3.0f; // Velocidade de queda padrão
        this.deltaX = 0;
        this.deltaY = 0;
        this.xAnterior = x;
        this.yAnterior = y;
        
        // Criar a estratégia de movimento adequada
        this.movementStrategy = new DropablePlatformStrategy(this, velocidade, 
                                                           tempoParaCairSegundos, visibleAfterFall);
    }
    
    /**
     * Construtor para plataforma estática (compatibilidade)
     */
    public PlataformaDinamica(int x, int y, int w, int h) {
        super(x, y, w, h);
        this.tipo = TipoMovimento.ESTATICA;
        this.deltaX = 0;
        this.deltaY = 0;
        this.xAnterior = x;
        this.yAnterior = y;
        
        // Criar a estratégia de movimento adequada (estática)
        this.movementStrategy = new StaticPlatformStrategy(this);
    }
    
    @Override
    public void update() {
        // Salvar a posição anterior para calcular o delta
        xAnterior = getX();
        yAnterior = getY();
        
        // Delegar a atualização para a estratégia de movimento
        movementStrategy.update();
        
        // Calcular o delta (mudança) na posição
        deltaX = getX() - xAnterior;
        deltaY = getY() - yAnterior;
    }
    
    /**
     * Método para informar se player está sobre a plataforma (para DROPABLE)
     */
    public void setPlayerSobre(boolean playerSobre) {
        if (movementStrategy instanceof DropablePlatformStrategy) {
            ((DropablePlatformStrategy) movementStrategy).setPlayerSobre(playerSobre);
        }
    }
    
    /**
     * Retorna a posição X atual da plataforma
     */
    @Override
    public int getX() {
        return movementStrategy.getX();
    }
    
    /**
     * Retorna a posição Y atual da plataforma
     */
    @Override
    public int getY() {
        return movementStrategy.getY();
    }
    
    @Override
    public Rectangle getBounds() {
        return new Rectangle(getX(), getY(), width, height);
    }
    
    @Override
    public void draw(Graphics g) {
        // Não desenhar se está invisível após queda
        if (getStatus() == StatusMovimento.CAIDA_INVISIVEL) {
            return;
        }
        
        // Desenhar diferente baseado no tipo
        Color corOriginal = g.getColor();
        Color corPreenchimento = getColor(); // Usar a cor definida na plataforma
        Color corBorda = getBorderColor();   // Usar a cor de borda definida
        
        // Alterar cores com base no estado da plataforma
        switch (tipo) {
            case MOVABLE:
                if (getStatus() == StatusMovimento.MOVENDO) {
                    corPreenchimento = Color.BLUE; // Azul quando movendo
                } else if (getStatus() == StatusMovimento.AGUARDANDO) {
                    corPreenchimento = Color.CYAN; // Ciano quando aguardando
                }
                break;
                
            case DROPABLE:
                if (getStatus() == StatusMovimento.CAINDO) {
                    corPreenchimento = Color.RED; // Vermelho quando caindo
                } else if (tipo == TipoMovimento.DROPABLE && 
                          movementStrategy instanceof DropablePlatformStrategy && 
                          ((DropablePlatformStrategy) movementStrategy).isPlayerSobre()) {
                    // Piscar amarelo quando player está sobre e contando tempo
                    long tempoAgora = System.currentTimeMillis();
                    if ((tempoAgora / 200) % 2 == 0) { // Piscar a cada 200ms
                        corPreenchimento = Color.YELLOW;
                    } else {
                        corPreenchimento = Color.ORANGE;
                    }
                }
                break;
                
            case ESTATICA:
            default:
                // Manter a cor definida na plataforma
                break;
        }
        
        // Desenhar a plataforma
        Rectangle bounds = getBounds();
        g.setColor(corPreenchimento);
        g.fillRect(bounds.x, bounds.y, bounds.width, bounds.height);
        g.setColor(corBorda);
        g.drawRect(bounds.x, bounds.y, bounds.width, bounds.height);
        
        // Restaurar a cor original
        g.setColor(corOriginal);
    }
    
    /**
     * Retorna o tipo de movimento da plataforma
     */
    public TipoMovimento getTipo() { 
        return tipo; 
    }
    
    /**
     * Retorna o status atual da plataforma
     */
    public StatusMovimento getStatus() { 
        return movementStrategy.getStatus(); 
    }
    
    /**
     * Verifica se a plataforma está visível
     */
    public boolean isVisivel() { 
        return getStatus() != StatusMovimento.CAIDA_INVISIVEL; 
    }
    
    /**
     * Verifica se a plataforma está se movendo
     */
    public boolean estaMovendo() {
        return getStatus() == StatusMovimento.MOVENDO;
    }
    
    /**
     * Retorna a variação de posição X desde a última atualização
     */
    public int getDeltaX() {
        return deltaX;
    }
    
    /**
     * Retorna a variação de posição Y desde a última atualização
     */
    public int getDeltaY() {
        return deltaY;
    }
    
    /**
     * Ativa o movimento da plataforma (útil para elevadores)
     */
    public void ativar() {
        if (tipo == TipoMovimento.MOVABLE) {
            movementStrategy.iniciarMovimento();
        }
    }
    
    /**
     * Move a plataforma para um ponto específico (controle manual do elevador)
     */
    public void irParaPonto(int indexPonto) {
        if (tipo == TipoMovimento.MOVABLE && movementStrategy instanceof MovingPlatformStrategy) {
            ((MovingPlatformStrategy) movementStrategy).irParaPonto(indexPonto);
        }
    }
    
    /**
     * Reseta uma plataforma DROPABLE para sua posição inicial
     */
    public void resetar() {
        if (tipo == TipoMovimento.DROPABLE && movementStrategy instanceof DropablePlatformStrategy) {
            ((DropablePlatformStrategy) movementStrategy).resetar();
        }
    }
}